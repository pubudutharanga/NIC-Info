{
  "rewrites": [
    {
      "source": "/old-to-new-nic",
      "destination": "/old-to-new-nic.html"
    },
    {
      "source": "/nic-from-dob",
      "destination": "/nic-from-dob.html"
    },
    {
      "source": "/nic-to-birthday",
      "destination": "/nic-to-birthday.html"
    },
    {
      "source": "/how-nic-works",
      "destination": "/how-nic-works.html"
    },
    {
      "source": "/excel-nic-formula",
      "destination": "/excel-nic-formula.html"
    },
    {
      "source": "/nic-check-digit",
      "destination": "/nic-check-digit.html"
    }
  ],
  "redirects": [
    {
      "source": "/si/nic-to-birthday",
      "destination": "/si/",
      "statusCode": 301
    },
    {
      "source": "/ta/nic-to-birthday",
      "destination": "/ta/",
      "statusCode": 301
    },
    {
      "source": "/si/(.*)",
      "destination": "/si/",
      "statusCode": 301
    },
    {
      "source": "/ta/(.*)",
      "destination": "/ta/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/(index\\.html|guidelines\\.html|old-to-new-nic|nic-from-dob|nic-to-birthday|how-nic-works|excel-nic-formula|nic-check-digit|$)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        }
      ]
    },
    {
      "source": "/(privacy|policy)\\.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/404(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|webp|svg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}